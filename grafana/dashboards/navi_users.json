{
  "uid": "navi-users",
  "title": "Na'vi Translator — User Analytics & Service Load",
  "tags": ["navi", "users", "load"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 38,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Active Users (last 5 min)",
      "type": "stat",
      "description": "Distinct IP addresses that made at least one translation request in the last 5 minutes.",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "blue", "value": null},
              {"color": "green", "value": 1},
              {"color": "yellow", "value": 10},
              {"color": "red", "value": 50}
            ]
          },
          "unit": "short",
          "color": {"mode": "thresholds"}
        }
      },
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "count(sum by (user_ip) (increase(navi_requests_by_user_total[5m]) > 0)) or vector(0)",
          "refId": "A",
          "legendFormat": "Active Users"
        }
      ]
    },
    {
      "id": 2,
      "title": "In-Flight Requests",
      "type": "stat",
      "description": "Currently processing translation requests.",
      "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 3},
              {"color": "red", "value": 10}
            ]
          },
          "unit": "short",
          "color": {"mode": "thresholds"}
        }
      },
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "navi_active_requests",
          "refId": "A",
          "legendFormat": "In-Flight"
        }
      ]
    },
    {
      "id": 3,
      "title": "Process Memory (MB)",
      "type": "stat",
      "description": "RSS memory used by the backend Python process.",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 500},
              {"color": "red", "value": 1500}
            ]
          },
          "unit": "none",
          "color": {"mode": "thresholds"}
        }
      },
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "navi_process_memory_mb",
          "refId": "A",
          "legendFormat": "MB"
        }
      ]
    },
    {
      "id": 4,
      "title": "Process CPU %",
      "type": "gauge",
      "description": "CPU utilisation of the backend process.",
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 50},
              {"color": "red", "value": 80}
            ]
          },
          "unit": "percent",
          "color": {"mode": "thresholds"}
        }
      },
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "navi_process_cpu_percent",
          "refId": "A",
          "legendFormat": "CPU %"
        }
      ]
    },
    {
      "id": 5,
      "title": "Total Unique Users (all time)",
      "type": "stat",
      "description": "Total distinct IPs that have ever called the API.",
      "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "blue", "value": null}]
          },
          "unit": "short",
          "color": {"mode": "thresholds"}
        }
      },
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "count(sum by (user_ip) (navi_requests_by_user_total)) or vector(0)",
          "refId": "A",
          "legendFormat": "Unique IPs"
        }
      ]
    },
    {
      "id": 6,
      "title": "Request Rate by User (last 1h)",
      "type": "table",
      "description": "Which IPs are making the most translation requests. High volume from one IP may indicate automated testing or stress.",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "options": {
        "sortBy": [{"displayName": "Requests", "desc": true}],
        "footer": {"show": false}
      },
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "user_ip"},
            "properties": [{"id": "displayName", "value": "User IP"}]
          },
          {
            "matcher": {"id": "byName", "options": "Value"},
            "properties": [{"id": "displayName", "value": "Requests"}]
          }
        ]
      },
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "sort_desc(sum by (user_ip) (increase(navi_requests_by_user_total[1h])))",
          "instant": true,
          "refId": "A",
          "legendFormat": "{{user_ip}}"
        }
      ],
      "transformations": [
        {"id": "labelsToFields", "options": {"mode": "rows"}},
        {"id": "organize", "options": {"excludeByName": {"Time": true}}}
      ]
    },
    {
      "id": 7,
      "title": "OOV (Gibberish) Tokens by User",
      "type": "table",
      "description": "Which IPs are sending the most out-of-vocabulary (unknown) Na'vi tokens. High counts suggest gibberish or non-Na'vi input.",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "options": {
        "sortBy": [{"displayName": "OOV Tokens", "desc": true}],
        "footer": {"show": false}
      },
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "user_ip"},
            "properties": [
              {"id": "displayName", "value": "User IP"},
              {"id": "custom.width", "value": 200}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Value"},
            "properties": [
              {"id": "displayName", "value": "OOV Tokens"},
              {"id": "custom.displayMode", "value": "color-background"},
              {"id": "thresholds", "value": {
                "mode": "absolute",
                "steps": [
                  {"color": "green", "value": null},
                  {"color": "yellow", "value": 10},
                  {"color": "red", "value": 50}
                ]
              }},
              {"id": "color", "value": {"mode": "thresholds"}}
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "sort_desc(sum by (user_ip) (navi_oov_by_user_total))",
          "instant": true,
          "refId": "A",
          "legendFormat": "{{user_ip}}"
        }
      ],
      "transformations": [
        {"id": "labelsToFields", "options": {"mode": "rows"}},
        {"id": "organize", "options": {"excludeByName": {"Time": true}}}
      ]
    },
    {
      "id": 8,
      "title": "Vocabulary Contributions by User",
      "type": "table",
      "description": "Who is contributing new vocabulary back to the dictionary. Power contributors help improve the model.",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "options": {
        "sortBy": [{"displayName": "Contributions", "desc": true}],
        "footer": {"show": false}
      },
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "user_ip"},
            "properties": [{"id": "displayName", "value": "User IP"}]
          },
          {
            "matcher": {"id": "byName", "options": "Value"},
            "properties": [
              {"id": "displayName", "value": "Contributions"},
              {"id": "custom.displayMode", "value": "color-background"},
              {"id": "thresholds", "value": {
                "mode": "absolute",
                "steps": [
                  {"color": "blue", "value": null},
                  {"color": "green", "value": 1},
                  {"color": "yellow", "value": 5}
                ]
              }},
              {"id": "color", "value": {"mode": "thresholds"}}
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "sort_desc(sum by (user_ip) (navi_vocab_by_user_total))",
          "instant": true,
          "refId": "A",
          "legendFormat": "{{user_ip}}"
        }
      ],
      "transformations": [
        {"id": "labelsToFields", "options": {"mode": "rows"}},
        {"id": "organize", "options": {"excludeByName": {"Time": true}}}
      ]
    },
    {
      "id": 9,
      "title": "Request Rate by User Over Time",
      "type": "timeseries",
      "description": "Request rate per user IP over time — shows usage patterns and spikes.",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["sum"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {"lineWidth": 2, "fillOpacity": 10}
        }
      },
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "sum by (user_ip) (rate(navi_requests_by_user_total[2m]))",
          "refId": "A",
          "legendFormat": "{{user_ip}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Process Memory Over Time",
      "type": "timeseries",
      "description": "Backend process memory trend — watch for leaks under load.",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 6},
      "options": {
        "tooltip": {"mode": "single"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {"lineWidth": 2, "fillOpacity": 20},
          "color": {"fixedColor": "blue", "mode": "fixed"}
        }
      },
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "navi_process_memory_mb",
          "refId": "A",
          "legendFormat": "Memory MB"
        }
      ]
    },
    {
      "id": 11,
      "title": "Process CPU % Over Time",
      "type": "timeseries",
      "description": "Backend CPU utilisation — spikes correlate with audio inference (Whisper is CPU-intensive).",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 6},
      "options": {
        "tooltip": {"mode": "single"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {"lineWidth": 2, "fillOpacity": 20},
          "color": {"fixedColor": "orange", "mode": "fixed"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 50},
              {"color": "red", "value": 80}
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "navi_process_cpu_percent",
          "refId": "A",
          "legendFormat": "CPU %"
        }
      ]
    }
  ]
}
